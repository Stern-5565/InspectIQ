# Committed (not secret) - see .env.development, its exact opposite. `vite build` extracts
# CSS into a real external stylesheet (`<link rel="stylesheet">`, confirmed by inspecting
# dist/index.html after a real build), not an inline <style> tag the way the dev server's HMR
# mechanism does - so the relaxation dev needs for CSP's style-src does not apply here.
VITE_CSP_STYLE_SRC="'self'"

# The real deployed backend (Phase 20). VITE_API_ORIGIN is deliberately origin-only, no /api
# suffix - see index.html's own comment on why CSP's connect-src needs the exact-match variant,
# separate from VITE_API_BASE_URL.
VITE_API_BASE_URL="https://inspectiq-api.orangesky-00064908.uksouth.azurecontainerapps.io/api"
VITE_API_ORIGIN="https://inspectiq-api.orangesky-00064908.uksouth.azurecontainerapps.io"
