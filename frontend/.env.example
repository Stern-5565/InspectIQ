# Copy this file to .env and fill in real local values.
# Never commit the real .env file.

# Local dev value. In production this must be the deployed backend's public URL - see
# docs/PROJECT_PLAN.md §20 (deployment, not yet decided). Vite bakes VITE_* vars into the
# built JS at BUILD time, not read at runtime - this has to be set as the hosting platform's
# build-time environment variable, not something changeable after the build without a rebuild.
VITE_API_BASE_URL=http://localhost:8000/api

# Same backend, but the ORIGIN ONLY - no /api path. Used only by index.html's CSP meta tag
# (connect-src). Keep this and VITE_API_BASE_URL's host in sync manually - CSP's path-matching
# is exact-match-or-nothing when a source includes a path at all, so reusing VITE_API_BASE_URL
# (which has /api) there would silently block every real API request. See index.html's own
# comment for the full story (this exact gotcha was found and documented on PropertyManager).
VITE_API_ORIGIN=http://localhost:8000
