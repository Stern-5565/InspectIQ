APP_ENV=development
APP_DEBUG=false

# CHANGE_ME_INSECURE_DEFAULT_FOR_DEV_ONLY is only valid while APP_ENV=development - startup
# fails if this placeholder (or any secret under 32 chars) is used with any other APP_ENV.
JWT_SECRET_KEY=CHANGE_ME_INSECURE_DEFAULT_FOR_DEV_ONLY
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Local dev default: Windows trusted connection against a local SQLEXPRESS instance.
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=InspectIQDb
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED_CONNECTION=true
DB_USER=
DB_PASSWORD=

# Comma-separated. Vite's default dev port.
CORS_ALLOWED_ORIGINS=http://localhost:5173
